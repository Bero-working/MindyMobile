{
  "name": "@sohantalukder/react-native-boilerplate",
  "version": "1.0.0",
  "description": "A comprehensive React Native template with modern tools and best practices",
  "main": "template.config.js",
  "author": "Sohan Talukder",
  "license": "MIT",
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "android:release": "react-native run-android --mode=release",
    "ios:release": "ENVFILE=.env.production react-native run-ios --mode=Release",
    "build:android": "cd android && ./gradlew assembleRelease",
    "build:android:bundle": "cd android && ./gradlew bundleRelease",
    "build:ios": "cd ios && ENVFILE=.env.production xcodebuild -workspace MindyMobile.xcworkspace -scheme MindyMobile -configuration Release -destination generic/platform=iOS -archivePath MindyMobile.xcarchive archive",
    "start": "react-native start",
    "test": "jest",
    "lint:rules": "eslint . --cache",
    "lint:code-format": "prettier --check \"{src,tests,__tests__}/**/*.{js,json,md,ts,tsx,yml,yaml}\"",
    "lint:type-check": "tsc",
    "lint": "npm run lint:rules && npm run lint:code-format && npm run lint:type-check",
    "lint:fix": "npm run lint:rules -- --fix && npm run lint:code-format -- --write && npm run lint:type-check",
    "test:report": "jest --collectCoverage --coverageDirectory=\"./coverage\" --ci --reporters=default --reporters=jest-junit --coverage",
    "pod-install": "npx pod-install",
    "prepare": "husky",
    "test:e2e": "maestro test e2e/flows"
  },
  "dependencies": {
    "@d11/react-native-fast-image": "^8.6.3",
    "@gorhom/bottom-sheet": "^5.2.6",
    "@react-native-clipboard/clipboard": "^1.15.0",
    "@react-native-community/netinfo": "^11.3.1",
    "@react-native/new-app-screen": "0.80.1",
    "@react-navigation/material-top-tabs": "^7.1.14",
    "@react-navigation/native": "^7.1.14",
    "@react-navigation/stack": "^7.4.2",
    "@shopify/flash-list": "^1.8.3",
    "@sohantalukder/rn-kit": "^0.1.0",
    "@tanstack/react-query": "^5.81.5",
    "axios": "^1.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^25.3.0",
    "nativewind": "^4.2.7",
    "react": "19.1.0",
    "react-error-boundary": "^6.0.0",
    "react-i18next": "^15.5.3",
    "react-native": "0.80.1",
    "react-native-config": "^1.7.2",
    "react-native-device-info": "^14.0.4",
    "react-native-gesture-handler": "^2.27.1",
    "react-native-get-random-values": "^1.11.0",
    "react-native-mmkv": "^3.3.0",
    "react-native-pager-view": "^6.4.1",
    "react-native-qrcode-svg": "6.3.26",
    "react-native-reanimated": "^3.18.0",
    "react-native-safe-area-context": "^5.5.1",
    "react-native-screens": "4.11.1",
    "react-native-svg": "^15.12.0",
    "react-native-webview": "^13.15.0",
    "tailwind-merge": "^2.6.1",
    "uuid": "^11.1.1",
    "zod": "^3.25.67",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/eslint-parser": "^7.25.3",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "^19.1.2",
    "@react-native-community/cli-platform-android": "^19.1.2",
    "@react-native-community/cli-platform-ios": "^19.1.2",
    "@react-native/babel-preset": "0.80.1",
    "@react-native/eslint-config": "0.80.1",
    "@react-native/metro-config": "0.80.1",
    "@react-native/typescript-config": "0.80.1",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.2.0",
    "@types/jest": "^29.5.13",
    "@types/node": "^22.10.2",
    "@types/react": "^19.1.0",
    "@types/react-native": "^0.73.0",
    "@types/react-test-renderer": "^19.1.0",
    "@typescript-eslint/eslint-plugin": "^8.35.1",
    "@typescript-eslint/parser": "^8.35.1",
    "babel-plugin-inline-dotenv": "^1.7.0",
    "babel-plugin-module-resolver": "^5.0.0",
    "babel-plugin-root-import": "^6.6.0",
    "dotenv": "^16.4.7",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-ft-flow": "^3.0.11",
    "eslint-plugin-jest": "^28.11.0",
    "eslint-plugin-react": "^7.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-native": "^4.0.0",
    "eslint-plugin-testing-library": "^7.2.0",
    "husky": "^9.1.7",
    "jest": "^29.6.3",
    "lint-staged": "^16.0.0",
    "msw": "^2.15.0",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.5.14",
    "react-native-svg-transformer": "^1.5.1",
    "react-test-renderer": "19.1.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=18"
  }
}
